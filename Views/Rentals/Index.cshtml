@model IEnumerable<RentalCRM.Models.Rental>

@{
    ViewData["Title"] = "Rentals";
}

<h1>Rentals</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Customer</th>
            <th>Rental Date</th>
            <th>Expected Return Date</th>
            <th>Actual Return Date</th>
            <th>Total Amount</th>
            <th>Deposit Amount</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerId</td>
                <td>@Html.DisplayFor(model => item.Customer)</td>
                <td>@item.RentalDate</td>
                <td>@item.ExpectedReturnDate</td>
                <td>@item.ActualReturnDate</td>
                <td>@item.TotalAmount</td>
                <td>@item.DepositAmount</td>
                <td>@item.Status</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">Edit</a> |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">Details</a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">Delete</a>

                    @if (item.Status != "Returned")
                    {
                        <form asp-controller="Rentals"
                              asp-action="Return"
                              asp-route-id="@item.Id"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success btn-sm">
                                Return
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
