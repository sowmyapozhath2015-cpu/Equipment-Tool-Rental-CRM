@model RentalCRM.Models.RentalItem

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>RentalItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RentalId" class="control-label"></label>

                <select asp-for="RentalId"
                        class="form-control"
                        asp-items="ViewBag.RentalId">
                    <option value="">-- Select Rental --</option>
                </select>

                <span asp-validation-for="RentalId" class="text-danger"></span>
            </div>

            

            <div class="form-group">
                <label asp-for="ProductId" class="control-label"></label>

                <select asp-for="ProductId"
                        class="form-control"
                        asp-items="ViewBag.ProductId">
                    <option value="">-- Select Product --</option>
                </select>

                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            

            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DailyRate" class="control-label"></label>
                <input asp-for="DailyRate" class="form-control" />
                <span asp-validation-for="DailyRate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DepositPerUnit" class="control-label"></label>
                <input asp-for="DepositPerUnit" class="form-control" />
                <span asp-validation-for="DepositPerUnit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
